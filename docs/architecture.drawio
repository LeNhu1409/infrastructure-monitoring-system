<mxfile host="app.diagrams.net"><diagram name="Kien-truc-giam-sat-v4" id="arch-v4"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="zA" value="&lt;b&gt;Đối tượng giám sát chính: 3 VM Ubuntu 22.04 · VirtualBox + Vagrant · host-only 192.168.56.0/24&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f0ee;strokeColor=#67ab9f;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1180" height="310" as="geometry"/></mxCell><mxCell id="zS" value="&lt;b&gt;Kịch bản lỗi (scenarios/vm/*.sh)&lt;/b&gt;&lt;br&gt;Gây lỗi qua vagrant ssh:&lt;br&gt;1. CPU cao: stress-ng trên vm-web&lt;br&gt;2. Disk đầy: ổ loop 200MB trên vm-db&lt;br&gt;3. Service down: dừng nginx / hkdn-api&lt;br&gt;4. CPU spike ngắn: tạo tải 30 giây,&lt;br&gt;    kỳ vọng không firing&lt;br&gt;&lt;br&gt;Sau khi gây lỗi xong: ghi INJECT, rồi hỏi&lt;br&gt;Prometheus API mỗi 2s tới khi thấy firing.&lt;br&gt;detection_time tính từ mốc INJECT,&lt;br&gt;chưa gồm group_wait của Alertmanager.&lt;br&gt;events.log: INJECT → DETECTED →&lt;br&gt;RECOVER → RESOLVED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;arcSize=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1240" y="50" width="320" height="310" as="geometry"/></mxCell><mxCell id="zD" value="&lt;b&gt;                                                              Docker Compose trên Docker Desktop (WSL2) · hệ thống giám sát&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="1530" height="610" as="geometry"/><