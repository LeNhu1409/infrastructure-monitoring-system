teSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="250" height="110" as="geometry"/></mxCell><mxCell id="dw" value="&lt;b&gt;demo-web (nginx)&lt;/b&gt;&lt;br&gt;:80 nội bộ / :8081 ra host&lt;br&gt;dịch vụ mẫu trong Docker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="460" width="200" height="110" as="geometry"/></mxCell><mxCell id="ne" value="&lt;b&gt;node-exporter (lab-host-1)&lt;/b&gt;&lt;br&gt;:9100 · giám sát VM Docker Desktop&lt;br&gt;(phụ, ngoài phạm vi luật cảnh báo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="250" height="90" as="geometry"/></mxCell><mxCell id="ca" value="&lt;b&gt;cAdvisor :8080&lt;/b&gt;&lt;br&gt;giám sát container (phụ)&lt;br&gt;Docker Desktop: nhãn name rỗng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="755" width="250" height="95" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b&gt;Prometheus :9090&lt;/b&gt;&lt;br&gt;scrape_interval 15s&lt;br&gt;evaluation_interval 15s&lt;br&gt;lưu chuỗi thời gian 15 ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="600" width="300" height="150" as="geometry"/></mxCell><mxCell id="ru" value="&lt;b&gt;config/alert.rules.yml (9 luật)&lt;/b&gt;&lt;br&gt;• NodeExporterDown (critical, 1m)&lt;br&gt;• ServiceDown: HTTP probe (critical, 30s)&lt;br&gt;• HighCpuUsage 70% / 90%, for 2m&lt;br&gt;• HighMemoryUsage 80% / 90%, for 5m&lt;br&gt;• DiskSpaceLow: phân vùng / thật, 80% / 90%, 5m&lt;br&gt;• DiskSpaceLowSimulated: metric giả lập &amp;gt; 80%, 1m&lt;br&gt;Áp dụng cho vm-web | vm-db | vm-app&lt;br&gt;Ngưỡng đề xuất cho prototype, chưa được mentor duyệt&lt;br&gt;Chưa có: luật TCP (Redis, MariaDB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="800" width="380" height="205" as="geometry"/></mxCell><mxCell id="am" value="&lt;b&gt;Alertmanager :9093&lt;/b&gt;&lt;br&gt;gom nhóm: alertname, instance&lt;br&gt;group_wait 10s · repeat 1h&lt;br&gt;ức chế warning khi có critical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="460" width="260" height="110" as="geometry"/></mxCell><mxCell id="rc" value="&lt;b&gt;Receiver: default&lt;/b&gt;&lt;br&gt;xem trên UI :9093" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="470" width="160" height="90" as="geometry"/></mxCell><mxCell id="tg" value="&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;tùy chọn, chưa bật&lt;br&gt;(config/…telegram.example)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="590" width="160" height="90" as="geometry"/></mxCell><mxCell id="gr" value="&lt;b&gt;Grafana :3000&lt;/b&gt;&lt;br&gt;dashboard theo host / service&lt;br&gt;CPU, RAM, disk, network,&lt;br&gt;trạng thái dịch vụ, uptime,&lt;br&gt;lịch sử cảnh báo (ALERTS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="700" width="260" height="140" as="geometry"/></mxCell><mxCell id="gp" value="&lt;b&gt;grafana/provisioning/&lt;/b&gt;&lt;br&gt;+ dashboards/*.json&lt;br&gt;(nạp tự động, có version control)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1080" y="880" width="260" height="100" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Chú giải&lt;/b&gt;&lt;br&gt;■ Exporter (xanh lá)&lt;br&gt;■ Dịch vụ bị giám sát (đỏ)&lt;br&gt;■ Prometheus (cam)&lt;br&gt;■ Alertmanager, Grafana (tím)&lt;br&gt;▭ Cấu hình (vàng, nét đứt)&lt;br&gt;→ liền: pull / truy vấn&lt;br&gt;⇢ đứt: probe / tùy chọn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="830" width="170" height="175" as="geometry"/></mxCell><mxCell id="usr" value="&lt;b&gt;Người vận hành&lt;/b&gt;&lt;br&gt;(trình duyệt)&lt;br&gt;:3000 Grafana&lt;br&gt;:9090 Prometheus&lt;br&gt;:9093 Alertmanager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1610" y="700" width="170" height="140" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Kiến trúc hệ thống giám sát N4.7 – v4 – 20/11/2026&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="800" height="30" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="600" as="sourcePoint"/><mxPoint x="230" y="345" as="targetPoint"/><Array as="points"><mxPoint x="790" y="382"/><mxPoint x="230" y="382"/></Array></mxGeometry></mxCell><mxCell id="e2" s