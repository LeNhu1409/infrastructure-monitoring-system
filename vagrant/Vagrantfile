# Lab 2 máy ảo Linux đa dịch vụ cho đề tài N4.7.
# Chạy: cd vagrant && vagrant up   (cần VirtualBox + Vagrant)
# Hướng dẫn đầy đủ: docs/vm-environment.md
#
#   vm-web  192.168.56.11  nginx + Node Exporter
#   vm-db   192.168.56.12  Redis + Node Exporter + Redis Exporter

VMS = {
  "vm-web" => { ip: "192.168.56.11", script: "web.sh", memory: 1024 },
  "vm-db"  => { ip: "192.168.56.12", script: "db.sh",  memory: 1024 },
}

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = false

  VMS.each do |name, cfg|
    config.vm.define name do |m|
      m.vm.hostname = name
      m.vm.network "private_network", ip: cfg[:ip]
      m.vm.provider "virtualbox" do |vb|
        vb.name   = "hkdn-#{name}"
        vb.memory = cfg[:memory]
        vb.cpus   = 1
      end
      m.vm.provision "shell", path: "provision/common.sh"
      m.vm.provision "shell", path: "provision/#{cfg[:script]}"
    end
  end
end
